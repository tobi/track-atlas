{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tobi/track-atlas/schema/track.schema.json",
  "title": "Track",
  "description": "Clean, source-agnostic metadata for a single racing circuit (tracks/<slug>/track.json). GENERATED from scripts/lib/models.py — do not edit by hand; run scripts/build_schema.py.",
  "$defs": {
    "Apex": {
      "additionalProperties": false,
      "description": "The geometric apex: the point of greatest curvature on the inside edge.",
      "properties": {
        "marker": {
          "description": "Lap fraction in [0,1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Marker",
          "type": "number"
        },
        "location": {
          "description": "[longitude, latitude] in GeoJSON axis order (WGS84).",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Location",
          "type": "array"
        },
        "edge": {
          "description": "The inside edge the apex lies on.",
          "enum": [
            "left",
            "right"
          ],
          "title": "Edge",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      },
      "required": [
        "marker",
        "location",
        "edge",
        "quality"
      ],
      "title": "Apex",
      "type": "object"
    },
    "Crossing": {
      "additionalProperties": false,
      "description": "A line across the track at one lap position (edge to edge).",
      "properties": {
        "marker": {
          "description": "Lap fraction in [0,1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Marker",
          "type": "number"
        },
        "line": {
          "description": "A 2-point line across the track: [point on the left edge, point on the right edge], left/right in the driving direction.",
          "items": {
            "description": "[longitude, latitude] in GeoJSON axis order (WGS84).",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Line",
          "type": "array"
        },
        "width_m": {
          "description": "Track width along the line.",
          "minimum": 0,
          "title": "Width M",
          "type": "number"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      },
      "required": [
        "marker",
        "line",
        "width_m",
        "quality"
      ],
      "title": "Crossing",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "centerline": {
          "description": "Path (relative to track dir) to the layout's GeoJSON centerline/layer file.",
          "title": "Centerline",
          "type": "string"
        },
        "surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path (relative to the track's raw dir) to the layout's surface GeoJSON: edges, midline, surface polygon, pit lane, crossing lines and apexes (docs/GEOMETRY.md).",
          "title": "Surface"
        },
        "crs": {
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        },
        "basis": {
          "default": "centerline",
          "description": "What `centerline` is and what every lap fraction is measured along: 'midline' = the measured surface midline (docs/GEOMETRY.md), 'centerline' = the OSM-derived line (unmeasured layouts).",
          "enum": [
            "centerline",
            "midline"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "centerline"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "LabelLayer": {
      "additionalProperties": false,
      "description": "Registry entry describing one label/name layer for clients.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable layer name for UI.",
          "title": "Label"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "title": "LabelLayer",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "aka": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aka",
          "type": "array"
        },
        "series": {
          "default": [],
          "description": "Series that use THIS layout/configuration.",
          "items": {
            "type": "string"
          },
          "title": "Series",
          "type": "array"
        },
        "length_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lap length in metres.",
          "title": "Length M"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "clockwise",
                "anticlockwise"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "active_years": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form, e.g. '2018-' or '1972,1979-1989'.",
          "title": "Active Years"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "label_default": {
          "default": "driver",
          "description": "Label layer code used as the default display name. Resolution is two steps: item.labels[label_default] if present, else item.labels.numbered.",
          "title": "Label Default",
          "type": "string"
        },
        "point_layers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PointLayer"
          },
          "title": "Point Layers",
          "type": "array"
        },
        "range_layers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RangeLayer"
          },
          "title": "Range Layers",
          "type": "array"
        },
        "surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/Surface"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "geometry"
      ],
      "title": "Layout",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "locality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locality"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Location",
      "type": "object"
    },
    "Percentiles": {
      "additionalProperties": false,
      "properties": {
        "p05": {
          "title": "P05",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "p95": {
          "title": "P95",
          "type": "number"
        }
      },
      "required": [
        "p05",
        "median",
        "p95"
      ],
      "title": "Percentiles",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "How a corner's entry/apex/exit were placed on the measured surface.",
      "properties": {
        "basis": {
          "description": "curvature: matched to a curvature peak of the measured midline; none: no peak near the legacy marker, so the corner has no entry/apex/exit.",
          "enum": [
            "curvature",
            "none"
          ],
          "title": "Basis",
          "type": "string"
        },
        "shape": {
          "anyOf": [
            {
              "enum": [
                "corner",
                "kink"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "kink when the peak radius exceeds 250 m.",
          "title": "Shape"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Turning direction measured from the geometry.",
          "title": "Direction"
        },
        "declared_direction": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when the curated direction disagrees with the measured one.",
          "title": "Declared Direction"
        },
        "radius_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum radius of the midline (8 m smoothing).",
          "title": "Radius M"
        },
        "marker_offset_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Curvature peak minus the legacy marker, in metres along the lap.",
          "title": "Marker Offset M"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "basis"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PointItem": {
      "additionalProperties": false,
      "description": "A discrete annotation on a layout lap coordinate.\n\nThe corners layer uses number/code/direction/scale/labels. Layout control\npoints such as start_finish, pit_entry and pit_exit usually use label,\nmarker and location.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "marker": {
          "anyOf": [
            {
              "description": "Lap fraction in [0,1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "location": {
          "anyOf": [
            {
              "description": "[longitude, latitude] in GeoJSON axis order (WGS84).",
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "location_source": {
          "anyOf": [
            {
              "enum": [
                "osm-way",
                "centerline",
                "midline",
                "manual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Source"
        },
        "labels": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "string"
            }
          },
          "title": "Labels",
          "type": "object"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "line": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crossing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout points (start/finish, pit entry/exit): the line across the track at the marker."
        },
        "entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crossing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Corners: the geometric turn-in line (curvature onset)."
        },
        "apex": {
          "anyOf": [
            {
              "$ref": "#/$defs/Apex"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Corners: the geometric apex on the inside edge."
        },
        "exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crossing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Corners: the geometric track-out line (curvature release)."
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Placement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scale": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Severity 1-6: 1=Hairpin, 2=Slow, 3=Medium, 4=Fast, 5=Very fast, 6=Kink.",
          "title": "Scale"
        }
      },
      "required": [
        "id"
      ],
      "title": "PointItem",
      "type": "object"
    },
    "PointLayer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "series": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Series",
          "type": "array"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PointItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "PointLayer",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "Absolute positioning of a surface measurement (lib/position.py).",
      "properties": {
        "frame": {
          "description": "Coordinate frame of every published coordinate: WGS 84 (G2139) ~ ITRF2014.",
          "title": "Frame",
          "type": "string"
        },
        "epoch": {
          "description": "Coordinate epoch (decimal year); plate motion moves ground a few cm/yr in this frame.",
          "title": "Epoch",
          "type": "number"
        },
        "source_frame": {
          "description": "Frame of the position reference, stepped to `frame`: NAD83(2011) for 3DEP lidar, WGS84-service for imagery served in Web Mercator.",
          "title": "Source Frame",
          "type": "string"
        },
        "imagery_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame the imagery was served in.",
          "title": "Imagery Frame"
        },
        "imagery_frame_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the imagery's frame was established (inferred from lidar, or catalog default).",
          "title": "Imagery Frame Basis"
        },
        "datum_shift_m": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "east/north metres added for source_frame -> frame.",
          "title": "Datum Shift M",
          "type": "object"
        },
        "registration_shift_m": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "east/north metres added to move the imagery onto the reference.",
          "title": "Registration Shift M",
          "type": "object"
        },
        "applied_shift_m": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Sum of the two, as applied to the traced geometry.",
          "title": "Applied Shift M",
          "type": "object"
        },
        "reference": {
          "$ref": "#/$defs/PositionReference"
        },
        "budget_ce95_m": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "95% horizontal error budget: reference, registration, datum, total.",
          "title": "Budget Ce95 M",
          "type": "object"
        },
        "imagery_stated_ce95_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imagery Stated Ce95 M"
        },
        "registration_model": {
          "description": "How the registration term of the budget was derived.",
          "title": "Registration Model",
          "type": "string"
        },
        "checks": {
          "default": [],
          "description": "Registration against every lidar survey and their mutual agreement.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "epoch",
        "source_frame",
        "datum_shift_m",
        "registration_shift_m",
        "applied_shift_m",
        "reference",
        "budget_ce95_m",
        "registration_model"
      ],
      "title": "Position",
      "type": "object"
    },
    "PositionReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "lidar",
            "imagery"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ce95_m": {
          "title": "Ce95 M",
          "type": "number"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "stated": {
          "description": "False when the reference's accuracy is an assumption (not stated by its producer).",
          "title": "Stated",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name",
        "ce95_m",
        "basis",
        "stated"
      ],
      "title": "PositionReference",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": true,
      "properties": {
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        },
        "corner_match": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corner Match"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "description": "Provenance and estimated positional accuracy of one geometric feature.",
      "properties": {
        "source": {
          "description": "What the position was measured from: an imagery source id (naip, ct-2023, indiana-2025, ... see layout.surface.sources.imagery), osm (OpenStreetMap trace), survey (a surveyed dataset), or derived (computed from other features).",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Source",
          "type": "string"
        },
        "accuracy_m": {
          "description": "Estimated absolute horizontal accuracy in metres (95%), in the atlas frame (layout.surface.position): the measurement's position CE95 combined with this feature's relative accuracy.",
          "minimum": 0,
          "title": "Accuracy M",
          "type": "number"
        },
        "relative_accuracy_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated accuracy relative to the rest of this layout's geometry, in metres (what matters for widths, lines and apexes against the edges).",
          "title": "Relative Accuracy M"
        },
        "measured": {
          "description": "True when the feature rests on edges actually seen in the imagery; false when it was bridged across an unseen span (shadow, bridge, run-off) or taken from a trace.",
          "title": "Measured",
          "type": "boolean"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Acquisition date of the source (ISO date).",
          "title": "Date"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source",
        "accuracy_m",
        "measured"
      ],
      "title": "Quality",
      "type": "object"
    },
    "RangeItem": {
      "additionalProperties": false,
      "description": "A lap interval annotation.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
